# bali-api 컨테이너 환경 변수 목록 (값은 넣지 않는다. 실제 값은 EC2에서 Secrets Manager로 .env를 생성)
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://postgres:5432/bali
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
GOOGLE_CLIENT_ID=
APPLE_BUNDLE_ID=
KAKAO_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# bali-batch는 SPRING_DATASOURCE_URL / SPRING_DATASOURCE_USERNAME / SPRING_DATASOURCE_PASSWORD 를 쓴다
